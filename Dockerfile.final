# Stage 1 - Build
FROM python:3.11-slim AS builder

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir --upgrade pip==25.3 wheel==0.46.2 && \
    pip install --no-cache-dir -r requirements.txt

# Stage 2 - Production
FROM python:3.11-slim AS production

RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

# Copy ONLY the app's dependencies — not pip, not wheel, not setuptools
COPY --from=builder /usr/local/lib/python3.11/site-packages/flask /usr/local/lib/python3.11/site-packages/flask
COPY --from=builder /usr/local/lib/python3.11/site-packages/werkzeug /usr/local/lib/python3.11/site-packages/werkzeug
COPY --from=builder /usr/local/lib/python3.11/site-packages/jinja2 /usr/local/lib/python3.11/site-packages/jinja2
COPY --from=builder /usr/local/lib/python3.11/site-packages/markupsafe /usr/local/lib/python3.11/site-packages/markupsafe
COPY --from=builder /usr/local/lib/python3.11/site-packages/itsdangerous /usr/local/lib/python3.11/site-packages/itsdangerous
COPY --from=builder /usr/local/lib/python3.11/site-packages/click /usr/local/lib/python3.11/site-packages/click

COPY app.py .

RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:5000/health')"

CMD ["python3", "app.py"]
